# SOVEREIGN META-AGENT — Environment Variables
# Copy this file to .env and fill in values as needed.
# SOVEREIGN itself does not require any environment variables.
# This file documents variables that opencode may use.

# opencode provider API keys (only if using paid providers)
# SOVEREIGN operates under a zero-cost constraint and does not require these.
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# GOOGLE_AI_API_KEY=
# MISTRAL_API_KEY=
# HF_TOKEN=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
